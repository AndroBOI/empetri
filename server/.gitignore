```gitignore
# =========================
# Python cache / compiled
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
venv/
.env/
ENV/
env/
.venv/

# =========================
# Environment variables
# =========================
.env
.env.local
.env.*.local

# =========================
# Flask
# =========================
instance/
.webassets-cache/

# =========================
# Distribution / packaging
# =========================
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =========================
# Logs
# =========================
*.log

# =========================
# Testing / coverage
# =========================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# =========================
# Jupyter Notebook
# =========================
.ipynb_checkpoints/

# =========================
# Type checkers
# =========================
.mypy_cache/
.pyre/
.pytype/

# =========================
# IDEs / Editors
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Node (if fullstack project)
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# SQLite databases
# =========================
*.sqlite3
*.db

# =========================
# Temporary files
# =========================
tmp/
temp/
*.tmp
```
